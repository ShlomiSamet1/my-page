# .env.example — a template showing which secrets the server needs.
# This file IS uploaded to GitHub, so it holds placeholders only.
#
# To use it: copy this file, name the copy ".env", and put real values in the copy.
# ".env" is listed in .gitignore, so it stays on your computer only.
# Online, the same values are stored in Cloudflare's settings instead (wrangler secret put).

# The dummy API key the server reads (it would be used to call an email service)
API_KEY=replace-with-your-api-key

# The password for the Admin page. Use a long one only you know.
ADMIN_PASSWORD=replace-with-a-long-password
